# 监听地址，默认只监听本机
CCWEB_HOST=127.0.0.1
CCWEB_PORT=18787

# 对外暴露时必须设置，访问时需要在页面输入该 token
# CCWEB_TOKEN=

# 要接的 CLI：tclaude（腾讯内部）或 claude（官方）
CCWEB_CLI=tclaude

# 默认模型。调试请用最便宜的：实测同一条请求，claude-haiku-4-5 单次约 $0.006
CCWEB_MODEL=claude-haiku-4-5

# 默认工作目录
CCWEB_CWD=/data/workspace

# 权限模式：default | acceptEdits | plan | bypassPermissions
CCWEB_PERMISSION_MODE=acceptEdits

# 可选：限制会话只能在这些目录下工作，多个用 : 分隔
# CCWEB_ALLOWED_ROOTS=/data/workspace:/home/yourname

# 可选：只读模式，禁止创建会话/发消息
# CCWEB_READ_ONLY=0

# tclaude 配置目录（一般不用改）
# TCLAUDE_HOME=/root/.tclaude
